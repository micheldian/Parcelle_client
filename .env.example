# ===== Base de données (Supabase PostgreSQL) =====
# URI "Transaction pooler" (port 6543) pour l'application
DATABASE_URL="postgresql://postgres.xxxx:MOT_DE_PASSE@aws-0-eu-west-3.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Connexion directe (port 5432) pour les migrations Prisma
DIRECT_URL="postgresql://postgres.xxxx:MOT_DE_PASSE@aws-0-eu-west-3.pooler.supabase.com:5432/postgres"

# ===== NextAuth =====
# Générer avec : openssl rand -base64 32
NEXTAUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"

# ===== Compte admin créé au seed =====
ADMIN_EMAIL="admin@agriconnect.local"
ADMIN_PASSWORD="changez-moi"

# ===== Telegram (dispatch main d'œuvre) =====
# Bot dédié créé via @BotFather (distinct des bots agents existants)
TELEGRAM_BOT_TOKEN=""
# chat_id du groupe "Chantiers" où le bot a été ajouté
TELEGRAM_DISPATCH_CHAT_ID=""
